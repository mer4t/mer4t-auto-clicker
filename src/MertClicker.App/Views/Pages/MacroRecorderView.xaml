<UserControl x:Class="MertClicker.App.Views.Pages.MacroRecorderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Makro Kaydedici" Style="{StaticResource PageTitleStyle}"/>

        <TextBlock Text="Kayıt sırasında fareyle yaptığınız hareketler, tıklamalar ve tekerlek hareketleri kaydedilir."
                   Style="{StaticResource PageBodyStyle}" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <TextBlock Text="{Binding HotkeyStatusText}" Style="{StaticResource PageBodyStyle}" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Kaydı Başlat" Command="{Binding StartRecordingCommand}" Padding="16,8" Margin="0,0,12,0"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="Kaydı Durdur" Command="{Binding StopRecordingCommand}" Padding="16,8"/>
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageBodyStyle}" Margin="0,0,0,16"/>

        <TextBlock Text="Son Kaydı Oynat" Style="{StaticResource PageBodyStyle}" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Oynat" Command="{Binding PlayLastRecordingCommand}" Padding="16,8" Margin="0,0,12,0"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="Duraklat" Command="{Binding PausePlaybackCommand}" Padding="16,8" Margin="0,0,12,0"/>
            <Button Content="Devam Et" Command="{Binding ResumePlaybackCommand}" Padding="16,8" Margin="0,0,12,0"/>
            <Button Content="Oynatmayı Durdur" Command="{Binding StopPlaybackCommand}" Padding="16,8"/>
        </StackPanel>

        <TextBlock Text="Son Kaydı Kütüphaneye Kaydet" Style="{StaticResource PageBodyStyle}" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBox Text="{Binding LastRecordedMacroName, UpdateSourceTrigger=PropertyChanged}"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                 BorderBrush="{StaticResource BorderBrush}" Padding="8,6" Margin="0,0,0,8"/>
        <Button Content="Kaydet" Command="{Binding SaveLastRecordingCommand}" Padding="16,8" HorizontalAlignment="Left"
                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="0,0,0,16"/>

        <TextBlock Text="Not: F8 / 'Son Kaydı Oynat', kaydetmeden de en son yapılan kaydı hızlıca test etmenizi sağlar.
                   Kütüphanedeki kayıtlı bir makroyu F8 ile oynatmak için Makrolarım ekranından bir makro seçin."
                   Style="{StaticResource PageBodyStyle}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
