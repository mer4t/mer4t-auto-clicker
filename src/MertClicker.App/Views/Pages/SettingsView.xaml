<UserControl x:Class="MertClicker.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Ayarlar" Style="{StaticResource PageTitleStyle}"/>

            <TextBlock Text="Genel Kısayollar" Style="{StaticResource PageBodyStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Her eylem için bir tuş ve isteğe bağlı değiştirici tuşlar seçin. Değişiklikler
                       'Kaydet' ile hemen (uygulamayı yeniden başlatmadan) etkili olur."
                       Style="{StaticResource PageBodyStyle}" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding HotkeyBindings}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryTextBrush}"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ComboBox ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding SelectedKey}"
                                              Width="90" Padding="6,4" Margin="0,0,12,0"/>
                                    <CheckBox Content="Ctrl" IsChecked="{Binding UseCtrl}"
                                              Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <CheckBox Content="Alt" IsChecked="{Binding UseAlt}"
                                              Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <CheckBox Content="Shift" IsChecked="{Binding UseShift}"
                                              Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <CheckBox Content="Win" IsChecked="{Binding UseWin}"
                                              Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Makro Kaydında Fare Hareketi Örnekleme" Style="{StaticResource PageBodyStyle}"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Kayıt sırasında yakalanan yoğun fare hareketleri, aşağıdaki eşiklere göre
                       seyreltilir. Değerler yalnızca sonraki kayıtlarda geçerli olur."
                       Style="{StaticResource PageBodyStyle}" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <TextBlock Text="Minimum Aralık (ms)" Style="{StaticResource PageBodyStyle}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding MinimumIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" Padding="8,6" Margin="0,0,0,16"/>

            <TextBlock Text="Minimum Mesafe (piksel)" Style="{StaticResource PageBodyStyle}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding MinimumDistancePixels, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" Padding="8,6" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Kaydet" Command="{Binding SaveCommand}" Padding="16,8" Margin="0,0,12,0"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                <Button Content="Diskten Yeniden Yükle" Command="{Binding LoadCommand}" Padding="16,8"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageBodyStyle}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
