<UserControl x:Class="MertClicker.App.Views.Pages.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Hakkında" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource PageBodyStyle}" Margin="0,0,0,12">
            <Run Text="Sürüm: "/>
            <Run Text="{Binding Version, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Text="{Binding Description}" Style="{StaticResource PageBodyStyle}"/>
    </StackPanel>
</UserControl>
