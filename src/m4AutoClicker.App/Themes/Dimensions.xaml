<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===================== 8px-based spacing scale ===================== -->
    <sys:Double x:Key="SpaceXS">4</sys:Double>
    <sys:Double x:Key="SpaceS">8</sys:Double>
    <sys:Double x:Key="SpaceM">12</sys:Double>
    <sys:Double x:Key="SpaceL">16</sys:Double>
    <sys:Double x:Key="SpaceXL">24</sys:Double>
    <sys:Double x:Key="SpaceXXL">32</sys:Double>
    <sys:Double x:Key="PageGap">40</sys:Double>

    <!-- ===================== Page shell layout ===================== -->
    <!-- Left/right 44, top 32, bottom 40 - identical on every page -->
    <Thickness x:Key="PageMargin">44,32,44,40</Thickness>
    <sys:Double x:Key="PageMaxWidth">1040</sys:Double>
    <Thickness x:Key="HeaderBlockMargin">0,0,0,16</Thickness>

    <!-- ===================== Common margins ===================== -->
    <Thickness x:Key="SectionSpacing">0,0,0,24</Thickness>
    <Thickness x:Key="SectionHeaderSpacing">0,0,0,14</Thickness>
    <Thickness x:Key="CardSpacing">0,0,0,14</Thickness>
    <Thickness x:Key="FormRowSpacing">0,0,0,18</Thickness>
    <Thickness x:Key="FieldGroupSpacing">0,0,24,0</Thickness>
    <Thickness x:Key="ButtonGroupItemSpacing">0,0,8,8</Thickness>

    <!-- ===================== Sizing ===================== -->
    <sys:Double x:Key="ControlHeight">42</sys:Double>
    <sys:Double x:Key="ButtonHeight">40</sys:Double>
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>
    <Thickness x:Key="CardPaddingCompact">16</Thickness>

</ResourceDictionary>
