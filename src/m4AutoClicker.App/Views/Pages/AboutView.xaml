<UserControl x:Class="m4AutoClicker.App.Views.Pages.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <HeaderedContentControl Header="Hakkında" Style="{StaticResource PageShellStyle}">
        <StackPanel HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Margin="{StaticResource SectionSpacing}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="56" Height="56" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding ApplicationName}" FontFamily="{StaticResource SerifFontFamily}"
                                   FontSize="20" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource PageBodyStyle}" Margin="0,0,0,10">
                            <Run Text="Sürüm "/>
                            <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource PageBodyStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Label Content="Özellikler" Style="{StaticResource SectionHeaderStyle}"/>
            <ItemsControl ItemsSource="{Binding Features}" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardCompactStyle}" Margin="{StaticResource CardSpacing}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryTextBrush}"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource PageBodyStyle}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="14"/>

            <Label Content="Varsayılan Kısayollar" Style="{StaticResource SectionHeaderStyle}"/>
            <Border Style="{StaticResource CardStyle}" Margin="{StaticResource CardSpacing}">
                <ItemsControl ItemsSource="{Binding Shortcuts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource SurfaceHoverBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CornerRadiusSmall}" Padding="8,3"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Action}" Style="{StaticResource PageBodyStyle}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="Tüm kısayollar Ayarlar ekranından yeniden atanabilir; değişiklikler uygulamayı yeniden başlatmadan hemen etkili olur."
                       Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource SectionSpacing}"/>

            <Label Content="Teknoloji" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Style="{StaticResource PageBodyStyle}" Margin="{StaticResource SectionSpacing}"
                       Text=".NET 10 · WPF (MVVM, CommunityToolkit.Mvvm) · CsWin32 ile üretilen güvenli Win32 P/Invoke çağrıları ile geliştirilmiştir."/>

            <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Geliştirici" Style="{StaticResource PageBodyStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding Developer}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Lisans" Style="{StaticResource PageBodyStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding LicenseName}" Foreground="{StaticResource PrimaryTextBrush}"/>
            </Grid>
            <Grid Margin="{StaticResource SectionSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Depo" Style="{StaticResource PageBodyStyle}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource PageBodyStyle}">
                    <Hyperlink NavigateUri="{Binding RepositoryUrl, Mode=OneWay}" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{Binding RepositoryUrl, Mode=OneWay}"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>

            <TextBlock Text="Bu araç yalnızca kendi bilgisayarınızda, kendi otomasyon ihtiyaçlarınız için kullanım amaçlıdır. Üçüncü taraf uygulamaların hizmet şartlarını ihlal edecek şekilde kullanılmasından kullanıcı sorumludur."
                       Style="{StaticResource SecondaryTextStyle}"/>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
