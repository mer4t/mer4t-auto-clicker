<UserControl x:Class="m4AutoClicker.App.Views.Pages.MyMacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <HeaderedContentControl Header="Makrolarım" Style="{StaticResource PageShellStyle}">
        <StackPanel HorizontalAlignment="Left">
            <TextBlock Text="Kaydedilmiş makrolarınızı burada görebilir, birini seçip F8 (veya Oynat) ile oynatabilir ya da silebilirsiniz."
                       Style="{StaticResource PageBodyStyle}" MaxWidth="640" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding HotkeyStatusText}" Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource SectionSpacing}"/>

            <Grid Margin="{StaticResource SectionSpacing}">
                <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" MinHeight="200" MaxHeight="320">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0">
                                    <Run Text="{Binding ActionCount, Mode=OneWay}"/>
                                    <Run Text=" eylem · Güncelleme: "/>
                                    <Run Text="{Binding UpdatedAtUtc, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Margin="0,4,0,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource AccentMutedBrush}" CornerRadius="{StaticResource CornerRadiusSmall}"
                                                    Padding="6,2" Margin="0,2,4,0">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Henüz kayıtlı makro yok."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Macros.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="{StaticResource SectionSpacing}">
                <StackPanel>
                    <Label Content="İşlemler" Style="{StaticResource SectionHeaderStyle}"/>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource ButtonGroupItemSpacing}">
                            <Button Content="Yenile" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource ButtonGroupItemSpacing}">
                            <Button Content="Oynat (F8)" Command="{Binding PlaySelectedCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Duraklat" Command="{Binding PausePlaybackCommand}" Margin="0,0,8,0"/>
                            <Button Content="Devam Et" Command="{Binding ResumePlaybackCommand}" Margin="0,0,8,0"/>
                            <Button Content="Durdur" Command="{Binding StopPlaybackCommand}" Margin="0,0,8,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource ButtonGroupItemSpacing}">
                            <Button Content="Dışa Aktar" Command="{Binding ExportSelectedCommand}" Margin="0,0,8,0"/>
                            <Button Content="İçe Aktar" Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
                            <Button Content="Sil" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButtonStyle}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="{StaticResource SectionSpacing}">
                <StackPanel>
                    <Label Content="Seçili Makronun Açıklama/Etiketlerini Düzenle" Style="{StaticResource SectionHeaderStyle}"/>

                    <TextBlock Text="Açıklama" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                             Width="500" HorizontalAlignment="Left" Margin="0,0,0,16"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top" Padding="10,8"/>

                    <TextBlock Text="Etiketler (virgülle ayırın)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding EditTagsText, UpdateSourceTrigger=PropertyChanged}"
                             Width="500" HorizontalAlignment="Left" Margin="0,0,0,18"/>

                    <Button Content="Makro Bilgilerini Kaydet" Command="{Binding SaveMacroDetailsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageBodyStyle}" Margin="0,0,0,10"/>
            <TextBlock Text="Yeni bir makro kaydetmek için Makro Kaydedici ekranını kullanın."
                       Style="{StaticResource SecondaryTextStyle}" MaxWidth="640"/>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
