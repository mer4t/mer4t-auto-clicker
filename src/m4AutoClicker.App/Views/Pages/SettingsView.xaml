<UserControl x:Class="m4AutoClicker.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <HeaderedContentControl Header="Ayarlar" Style="{StaticResource PageShellStyle}">
        <StackPanel HorizontalAlignment="Left">

            <Label Content="Genel Kısayollar" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="Bir kısayola tıklayın, ardından istediğiniz tuş kombinasyonuna basın (örn. F6 ya da Ctrl+Shift+F7). 'Kaydet' ile hemen (uygulamayı yeniden başlatmadan) etkili olur."
                       Style="{StaticResource PageBodyStyle}" MaxWidth="640" Margin="0,0,0,16"/>

            <ItemsControl ItemsSource="{Binding HotkeyBindings}" Margin="{StaticResource SectionSpacing}"
                          Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardCompactStyle}" Margin="{StaticResource CardSpacing}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" SharedSizeGroup="HotkeyLabel"/>
                                    <ColumnDefinition Width="200" SharedSizeGroup="HotkeyControl"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding DisplayText}" Style="{StaticResource HotkeyCaptureButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Click="HotkeyCaptureButton_Click" PreviewKeyDown="HotkeyCaptureButton_PreviewKeyDown"
                                        LostKeyboardFocus="HotkeyCaptureButton_LostKeyboardFocus"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label Content="Makro Kaydında Fare Hareketi Örnekleme" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="Kayıt sırasında yakalanan yoğun fare hareketleri, aşağıdaki eşiklere göre seyreltilir. Değerler yalnızca sonraki kayıtlarda geçerli olur."
                       Style="{StaticResource PageBodyStyle}" MaxWidth="640" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardStyle}" Margin="{StaticResource SectionSpacing}">
                <StackPanel>
                    <TextBlock Text="Minimum Aralık (ms)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding MinimumIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                             Width="160" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="Minimum Mesafe (piksel)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding MinimumDistancePixels, UpdateSourceTrigger=PropertyChanged}"
                             Width="160" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,0,0,16">
                <Button Content="Kaydet" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="{StaticResource ButtonGroupItemSpacing}"/>
                <Button Content="Diskten Yeniden Yükle" Command="{Binding LoadCommand}" Margin="{StaticResource ButtonGroupItemSpacing}"/>
            </WrapPanel>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageBodyStyle}"/>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
